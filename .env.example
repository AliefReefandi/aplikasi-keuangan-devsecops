# Konfigurasi koneksi database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=keuangan

# Akun aplikasi
MYSQL_APP_USER=keuangan_app
MYSQL_APP_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK

# Password administrator database
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_ACAK

# Flask
SECRET_KEY=GANTI_DENGAN_SECRET_KEY_ACAK_PANJANG
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false

# Grafana alert email (SMTP Gmail)
# GRAFANA_SMTP_USER: alamat Gmail pengirim
# GRAFANA_SMTP_PASSWORD: Gmail App Password 16 karakter (BUKAN password akun Gmail)
# GRAFANA_ALERT_EMAIL: penerima alert, pisahkan dengan ; jika lebih dari satu
GRAFANA_SMTP_USER=pengirim@gmail.com
GRAFANA_SMTP_PASSWORD=GANTI_DENGAN_GMAIL_APP_PASSWORD
GRAFANA_ALERT_EMAIL=penerima@example.com
