
loki.source.file "security_logs" {
    targets = [
        {
            __path__ = "/var/log/app/security.log",
            job      = "catatuang-security",
            service  = "flask-app",
        },
    ]

    forward_to = [loki.write.local.receiver]
}

loki.write "local" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}
